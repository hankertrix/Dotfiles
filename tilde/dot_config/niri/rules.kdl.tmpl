// Window and layer rules

// Put the wallpaper inside the overview backdrop.
layer-rule {
    match namespace="^awww-daemon$"
    place-within-backdrop true
}

// Make waybar slightly transparent.
layer-rule {
    match namespace="^waybar$"
    opacity 0.8
}

// Window rules that apply to all windows.
window-rule {

    // Never draw the border with background.
    draw-border-with-background false

    // Semi-transparent windows.
    opacity 0.9

    // Blur the background behind windows.
    background-effect {
        blur true
    }

    // Rounded corners on windows.
    geometry-corner-radius {{ .windowCornerRadius }}
    clip-to-geometry true
}

// Make media windows fully opaque
window-rule {

    // Media viewers or players
    match app-id=r#"^(?:mpv|oculante|com\.gabm\.satty)$"#

    // Firefox's picture in picture
    match app-id=r#"^firefox$"# title="^Picture-in-Picture$"

    opacity 1.0
}

// Make some applications open full screen by default
window-rule {

    // Main thunderbird window
    match app-id=r#"^org\.mozilla\.Thunderbird$"# title="Mozilla Thunderbird$"

    // FreeCAD
    match app-id=r#"org.freecad.FreeCAD"#

    default-column-width {
        proportion 1.0
    }
}

// Open Steam as floating.
window-rule {
    match app-id=r#"^steam$"#
    open-floating true
}

// Work around WezTerm's initial configure bug
// by setting an empty default-column-width.
window-rule {
    // This regular expression is intentionally made as specific as possible,
    // since this is the default config, and we want no false positives.
    // You can get away with just app-id="wezterm" if you want.
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// Example: block out two password managers from screen capture.
// (This example rule is commented out with a "/-" in front.)
/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#

    block-out-from "screen-capture"

    // Use this instead if you want them visible on 3rd-party screenshot tools.
    // block-out-from "screencast"
}

// Example: enable rounded corners for all windows.
// (This example rule is commented out with a "/-" in front.)
/-window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

