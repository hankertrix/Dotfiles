#![enable(implicit_some, unwrap_newtypes, unwrap_variant_newtypes)]
(
    address: "127.0.0.1:6600",
    password: None,
    theme: "dynamic",
    cache_dir: None,
    on_song_change: None,
    volume_step: 5,
    max_fps: 30,
    scrolloff: 8,
    wrap_navigation: true,
    enable_mouse: true,
    enable_config_hot_reload: true,
    status_update_interval_ms: 1000,
    rewind_to_start_sec: 10,
    keep_state_on_song_change: true,
    reflect_changes_to_playlist: false,
    select_current_song_on_change: false,
    browser_song_sort: [Disc, Track, Artist, Title],
    directories_sort: SortFormat(
        group_by_type: true,
        reverse: false,
    ),
    album_art: (
        method: Auto,
        max_size_px: (width: 1200, height: 1200),
        disabled_protocols: ["http://", "https://"],
        vertical_align: Center,
        horizontal_align: Center,
    ),
    cava: (
        input: (
            method: Fifo,
            source: "/tmp/mpd.fifo",
            sample_rate: 44100,
            channels: 2,
            sample_bits: 16,
        ),
    ),
    keybinds: (
        global: {
            "3": SwitchToTab("Albums"),
            "4": SwitchToTab("Playlists"),
            "5": SwitchToTab("Search"),
            "S": SwitchToTab("Search"),
            "[": PreviousTab,
            "]": NextTab,
        },
    ),
    search: (
        case_sensitive: false,
        mode: Contains,
        tags: [
            (
                value: "any",
                label: "Any Tag",
            ),
            (
                value: "title",
                label: "Title",
            ),
            (
                value: "artist",
                label: "Artist",
            ),
            (
                value: "album",
                label: "Album",
            ),
            (
                value: "albumartist",
                label: "Album Artist",
            ),
            (
                value: "filename",
                label: "Filename",
            ),
            (
                value: "genre",
                label: "Genre",
            ),
        ],
    ),
    artists: (
        album_display_mode: SplitByDate,
        album_sort_by: Date,
    ),
    tabs: [
        (
            name: "Queue",
            pane: Split(
                direction: Horizontal,
                panes: [
                    (
                        size: "40%",
                        pane: Split(
                            direction: Vertical,
                            panes: [
                                (
                                    size: "50%",
                                    pane: Pane(AlbumArt),
                                ),
                                (
                                    size: "50%",
                                    pane: Pane(Cava),
                                ),
                            ],
                        ),
                    ),
                    (
                        size: "1",
                        pane: Pane(Empty()),
                    ),
                    (
                        size: "60%",
                        pane: Split(
                            direction: Vertical,
                            panes: [
                                (
                                    size: "3",
                                    pane: Pane(QueueHeader()),
                                    borders: "TOP | BOTTOM",
                                ),
                                (
                                    size: "100%",
                                    pane: Pane(Queue),
                                )
                            ]
                        )
                    ),
                ],
            ),
        ),
        (
            name: "Directories",
            pane: Pane(Directories),
        ),
        (
            name: "Albums",
            pane: Pane(Albums),
        ),
        (
            name: "Playlists",
            pane: Pane(Playlists),
        ),
        (
            name: "Search",
            pane: Pane(Search),
        ),
    ],
)
